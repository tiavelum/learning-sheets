{
  "name": "learning-sheets",
  "private": true,
  "description": "Checks the sheet folders, renders each sheet to PDF and builds the browse page",
  "scripts": {
    "check": "node scripts/check-sheets.mjs",
    "render": "node scripts/render-sheets.mjs",
    "site": "node scripts/build-site.mjs",
    "test": "node --test",
    "lint": "biome ci .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/source-sans-3": "5.3.1",
    "parse5": "8.1.0",
    "pdf-lib": "1.17.1",
    "playwright": "1.63.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4"
  }
}
