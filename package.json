{
  "name": "learning-sheets",
  "private": true,
  "description": "Checks the sheet folders, renders each sheet to PDF and builds the browse page",
  "scripts": {
    "check": "node scripts/check-sheets.mjs",
    "render": "node scripts/render-sheets.mjs",
    "site": "node scripts/build-site.mjs",
    "test": "node --test",
    "lint": "biome ci .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/noto-emoji": "5.3.2",
    "@fontsource/noto-sans-math": "5.3.0",
    "@fontsource/noto-sans-symbols-2": "5.3.0",
    "@fontsource/red-hat-text": "5.3.0",
    "@fontsource/saira-stencil-one": "5.3.0",
    "@fontsource/source-sans-3": "5.3.1",
    "@fontsource/zilla-slab": "5.3.0",
    "parse5": "8.1.0",
    "pdf-lib": "1.17.1",
    "playwright": "1.63.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4"
  }
}
